# Copy to apps/mobile/.env.local. Expo inlines EXPO_PUBLIC_ variables when it bundles.

# Base URL of the Crowdpulse web server, with no trailing slash. The phone cannot reach
# localhost: use the https URL that `ngrok http <port>` prints.
EXPO_PUBLIC_API_URL=https://example.ngrok-free.app

# Not for this file: EXPO_PUBLIC_SIM_API_URL. The simulator rig (scripts/sim-qa.sh) sets it in
# Metro's environment to point the simulators at a server on the Mac, and it wins over
# EXPO_PUBLIC_API_URL. In an .env file it would point real phones at localhost.
