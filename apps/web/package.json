{
  "name": "@triagecam/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local src/db/migrate.mts",
    "db:reset": "node --env-file-if-exists=.env.local src/db/reset.mts && pnpm db:migrate",
    "test": "node --test 'src/**/*.test.ts'",
    "face:models": "node scripts/fetch-face-models.mjs",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env.local scripts/seed.mts",
    "smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke.mts",
    "intake:sim": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/intake-sim.mts"
  },
  "dependencies": {
    "@triagecam/contracts": "workspace:*",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "onnxruntime-node": "^1.31.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3"
  }
}
