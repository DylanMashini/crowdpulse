# Copy to apps/web/.env.local. Next.js and the db scripts read it from there.

# Postgres connection string. The local Homebrew server needs no password.
DATABASE_URL=postgres://localhost:5432/triagecam

# Public base URL of this server, used for the link in verification emails.
# Use the ngrok URL when the phone has to open the link.
APP_URL=http://localhost:3100

# Resend API key for verification emails. Leave empty in development: the server then logs
# the verification link and returns devVerificationToken from sign-up instead of sending.
RESEND_API_KEY=

# From address for verification emails. Must be on a domain verified in Resend;
# onboarding@resend.dev only delivers to the Resend account owner's own address.
# EMAIL_FROM is the older name for the same thing and is read when RESEND_FROM is empty.
RESEND_FROM=Triage Cam <onboarding@resend.dev>
EMAIL_FROM=

# Optional Expo access token for sending push notifications, if the Expo project
# has enhanced push security turned on.
EXPO_ACCESS_TOKEN=

# Where pushes are sent. Leave empty for Expo's push service. The smoke test points it at a
# local sink (EXPO_PUSH_URL=http://localhost:3191/push with SMOKE_PUSH_SINK=3191).
EXPO_PUSH_URL=

# Directory for sitting files uploaded during development (PUT /api/sittings/:id/file).
# Relative paths resolve from apps/web. Uploads are refused when NODE_ENV is production.
SITTING_FILES_DIR=./recordings

# Directory of the face-match models, downloaded by `pnpm --filter @triagecam/web face:models`
# (about 39 MB, git-ignored). Relative paths resolve from apps/web. Without the files the
# face routes answer 503 face_unavailable and the ticket number is used instead.
#   Detector: YuNet, face_detection_yunet_2023mar.onnx, MIT licence.
#   Embedding: SFace, face_recognition_sface_2021dec.onnx, Apache-2.0 licence; stored with
#   each embedding as "sface-2021dec". Both are from https://github.com/opencv/opencv_zoo
#   Only the 128 numbers of the embedding are stored, never the picture.
FACE_MODELS_DIR=./.models

# How many proxies of ours are in front of the server, for the rate limits: the caller's address
# is that many entries from the right of X-Forwarded-For. Production sets 2 (Cloudflare, then
# the load balancer). Leave empty in development: the first entry is used, as a tunnel reports it.
TRUSTED_PROXY_HOPS=

# Account created by `pnpm --filter @triagecam/web db:seed`. Development only.
SEED_EMAIL=demo@triagecam.test
SEED_PASSWORD=triagecam-demo

# Next.js build output directory. Set per dev server so several can run at once,
# for example NEXT_DIST_DIR=.next-3101 with PORT=3101.
# NEXT_DIST_DIR=.next

# Dashboard development only. Set to 1 to run the dashboard against an in-browser mock of the
# API (apps/web/src/lib/mock) instead of the real routes. Leave unset everywhere else: the mock
# is a separate chunk that the browser only fetches when this is 1.
# NEXT_PUBLIC_API_MOCK=1
